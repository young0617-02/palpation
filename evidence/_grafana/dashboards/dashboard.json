  "alertRuleGroup": {
    "name": "edge-agent-alerts",
    "interval": "1m",
    "rules": [
      {
        "name": "推理 P95 延迟超阈值",
        "condition": "A",
        "message": "边缘推理 P95 延迟超过 1200ms，可能影响实时性",
        "for": "5m",
        "labels": {
          "severity": "warning",
          "team": "edge"
        },
        "annotations": {
          "summary": "推理 P95 延迟超阈值",
          "description": "边缘推理 P95 延迟超过 1200ms，可能影响实时性"
        }
      },
      {
        "name": "队列积压告警",
        "condition": "A",
        "message": "边缘队列深度超过 1000，断网补传可能丢失事件",
        "for": "10m",
        "labels": {
          "severity": "warning",
          "team": "edge"
        },
        "annotations": {
          "summary": "队列积压告警",
          "description": "边缘队列深度超过 1000，断网补传可能丢失事件"
        }
      },
      {
        "name": "边缘设备离线超时",
        "condition": "A",
        "message": "边缘设备离线超过 1 小时，请检查网络连接",
        "for": "30m",
        "labels": {
          "severity": "warning",
          "team": "edge"
        },
        "annotations": {
          "summary": "边缘设备离线超时",
          "description": "边缘设备离线超过 1 小时，请检查网络连接"
        }
      },
      {
        "name": "CPU 温度过高",
        "condition": "A",
        "message": "边缘设备 CPU 温度超过 85°C，可能触发降级",
        "for": "5m",
        "labels": {
          "severity": "warning",
          "team": "edge"
        },
        "annotations": {
          "summary": "CPU 温度过高",
          "description": "边缘设备 CPU 温度超过 85°C，可能触发降级"
        }
      },
      {
